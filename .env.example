# =============================================================================
# SMELS front-office — modèle LOCAL
# =============================================================================
# cp .env.example .env

# API backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090

# Multi-tenant : schoolId automatique au login (jamais saisi). Requis hors SUPER_ADMIN.
# Aligné sur smels.security.mock-users.school-id du back (dev).
# Après modification : redémarrer `npm run dev` (Next injecte NEXT_PUBLIC_* au démarrage).
NEXT_PUBLIC_DEFAULT_SCHOOL_ID=school-demo-elshammah

# Branding déploiement (libellés UI — pas d’id technique)
NEXT_PUBLIC_SCHOOL_DISPLAY_NAME=El Shammah
NEXT_PUBLIC_APP_DISPLAY_NAME=SMELS

# Mode personas sans API (dev UI seulement). Laisser false pour l’auth réelle.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
